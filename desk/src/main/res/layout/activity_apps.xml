<?xml version="1.0" encoding="utf-8"?>
<!--
  应用模块页。结构、坐标、卡片语言全部照搬 activity_bili.xml：
  左上胶囊 + 居中页签 + 子页签 + 6 列卡片墙，只有 ids 换成 apps_*。

  和 B 站页差两处，都是内容性质决定的：
  1. 没有「当前视图锚点图」（bili_head_cover）——本页的标题是「可启动」这种栏目名，
     不对应任何一张封面，放个空位反而漏出一块直角底。
  2. 整页背景跟着「聚焦那个应用的图标」走（AppPage#showBackground），
     图标本身没有 URL，所以是代码里塞 Drawable 而不是 Glide 取图。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/desk_bg" />

    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 整页背景。alpha 由代码控制（没有图标时淡出回氛围底） -->
    <ImageView
        android:id="@+id/apps_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_music_scrim" />

    <!-- paddingTop = top_bar_top + top_bar_height + 16 = 80dp。
         内容层不裁剪的话，墙整行翻上去会连自己带出边界，压在标题和顶栏上。 -->
    <LinearLayout
        android:id="@+id/apps_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="80dp"
        android:paddingEnd="48dp">

        <!-- ============ 标题 + 搜索框 ============ -->
        <!-- 平时整行收起来：Aerial 顶栏下面直接就是磁贴，中间不夹任何东西。
             只有「搜索」栏目才露出来。 -->
        <LinearLayout
            android:id="@+id/apps_tool_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 标题与计数不再显示：Aerial 的 Home 只有图标墙，说明文字留给副标题行 -->
                <TextView
                    android:id="@+id/apps_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="可启动"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/module_title_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/apps_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              只在「搜索」栏目露出来（AppPage 控制显隐）。
              flagNoExtractUi 是必须的：电视上输入法默认会切成整屏手写/抽取模式，
              一敲字卡片墙就被输入法盖满（所有输入框同一个写法，见 dialog_source 等）。
            -->
            <EditText
                android:id="@+id/apps_search"
                android:layout_width="420dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_dialog_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="按应用名筛选"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:textColor="#F5F7FA"
                android:textColorHint="#6F7280"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!--
          子页签（排序方式）。和 B 站页的分区签同一个位置、同一套样式，
          负 margin + clipChildren=false 一路给到 root，焦点放大 1.06 不会切边。
        -->
        <!-- 排序方式不再用一排 chips（Aerial 是靠「长按 → 移动」自己排），
             这一行整条不进布局，代码里也只留空实现 -->
        <HorizontalScrollView
            android:id="@+id/apps_sub_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/apps_sub_nav"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </HorizontalScrollView>

        <!-- 磁贴墙。参数照搬 Aerial TV 的 HomeScreen.GridMetrics：5 列 / 28dp 横距 /
             行距 = 磁贴高 + 名字区。磁贴本身 16:9，卡片视图自己量。

             不再是 GridView：它只挂载视口附近的卡，带焦点的那张一被回收焦点就没主了
             （「翻页跳左上角」的根）。TileWall 全量挂载 + 自己算焦点，
             列数/间距/行高都由它自己定，这里只留下内边距。 -->
        <com.tvdesk.desk.widget.TileWall
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="28dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/apps_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 顶栏压暗罩：卡片墙关掉了 clipChildren（聚焦放大要溢出格子），滚动时上一排的卡
         会画到内容区以外、直接压在顶栏胶囊上。这一层上面的部分不透明，往下淡出；
         顺序就是绘制顺序，所以它在内容之后、胶囊之前 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_gravity="top"
        android:background="@color/desk_bg"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_gravity="top"
        android:layout_marginTop="94dp"
        android:background="@drawable/bg_top_scrim"
        android:clickable="false"
        android:focusable="false" />

    <!-- ============ 左上：模块胶囊 ============ -->
    <LinearLayout
        android:id="@+id/apps_switcher"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="@dimen/top_bar_top"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/switcher_pad_h"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="@dimen/switcher_icon"
            android:layout_height="@dimen/switcher_icon"
            android:src="@drawable/ic_menu_list" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/switcher_gap"
            android:text="应用"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- ============ 顶部中央：栏目 ============ -->
    <LinearLayout
        android:id="@+id/apps_nav_items"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/top_bar_top"
        android:background="@drawable/bg_pill"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp" />

    <!-- 首次扫描设备要把图标从磁盘读出来，那段时间给一个明确的「在等」 -->
    <ProgressBar
        android:id="@+id/apps_loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!--
      胶囊下拉（默认收起）。必须放在 root 的最后一个子节点：
      FrameLayout 按子节点顺序绘制，放在内容层前面就会被 32sp 的页面标题压在下面。
      elevation 在 minSdk 19 上不保证生效，所以用顺序而不是层级。
    -->
    <LinearLayout
        android:id="@+id/apps_menu"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_module_menu"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

</FrameLayout>
