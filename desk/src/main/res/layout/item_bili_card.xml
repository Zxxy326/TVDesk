<?xml version="1.0" encoding="utf-8"?>
<!--
  哔哩哔哩卡片。语言完全照搬影视页/音乐页的卡片：
  外框（bg_poster：聚焦白边 + 圆角）→ 内缩 3dp 的封面 → 下面两行文字。

  唯一和影视页不同的地方是封面比例：B 站的稿件封面本来就是 16:10，
  强行套 2:3 会把上下裁掉，所以这里把图框锁成 116dp（列宽约 180dp）。
  标题留两行——B 站标题普遍很长，一行几乎切不出有用信息。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bili_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/bili_card_frame"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:background="@drawable/bg_poster"
        android:duplicateParentState="true"
        android:padding="3dp">

        <!-- 没图时的底：在线封面到了会被 ImageView 盖住 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover_placeholder" />

        <ImageView
            android:id="@+id/bili_card_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- 右下角标：视频是时长，直播是「 watching 人数」/「未开播」 -->
        <TextView
            android:id="@+id/bili_card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_bili_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="#F2F5FA"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/bili_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="#F2F5FA"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/bili_card_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#8A93A6"
        android:textSize="13sp" />
</LinearLayout>
