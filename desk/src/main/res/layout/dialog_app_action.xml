<?xml version="1.0" encoding="utf-8"?>
<!--
  应用卡片的操作弹窗（长按确认键弹出）。

  动作行由代码按这个应用能做什么现生成（能不能打开、是不是预装），所以这里只留一个空容器。
  底部固定一条「取消」：这个弹窗至少要有两条出路——点取消或按 BACK，
  不能出现「打开了却退不出去」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/dialog_app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_app_pkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/dialog_app_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/dialog_app_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_dialog_btn"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="取消"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />
</LinearLayout>
