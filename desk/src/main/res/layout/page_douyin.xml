<?xml version="1.0" encoding="utf-8"?>
<!--
  抖音模块页：竖屏信息流。

  这是全站唯一不按卡片墙排的版块，依据是技术方案 §6.2「竖屏卡片，按键一次切一条，200ms 上滑」。
  遥控器没有惯性滚动，所以不做列表、不做滚动条，一次只看一条，上下键换条。

  横屏 1280×720dp 画布上，9:16 的画面只占中间约 405dp 宽，两侧正好放信息文字和互动栏
  ——这也是抖音自己的大屏版布局。画面背后铺一张同一封面的放大图（dy_backdrop）压暗，
  避免两侧是大块死黑。

  dy_stage 是「会滑的那一层」：换条时整层上滑出去、再从下面滑回来。
  播放器只有一个实例，所以动画只能作用在整层上，不能做成两张卡对拷。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/dy_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_music_scrim" />

    <FrameLayout
        android:id="@+id/dy_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/dy_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:focusable="false"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <!-- 出画之前先顶一张封面，不然换条时用户看到的是黑一下而不是「滑走了一张卡」 -->
        <ImageView
            android:id="@+id/dy_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- ============ 左上：模块胶囊（触屏出口，退页另有 BACK） ============
             不给焦点：本页四个方向键全被换条/点赞/评论占了，焦点永远走不到这颗上；
             它一旦可聚焦，弹窗关掉后系统就会把焦点丢回它，用户下一次按确定直接退出抖音页。 -->
        <LinearLayout
            android:id="@+id/dy_switcher"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_height"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/screen_pad"
            android:layout_marginTop="@dimen/top_bar_top"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/switcher_pad_h"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="@dimen/switcher_icon"
                android:layout_height="@dimen/switcher_icon"
                android:src="@drawable/ic_menu_list" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/switcher_gap"
                android:text="抖音"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- ============ 右上：当前档位 + 按键说明 ============ -->
        <TextView
            android:id="@+id/dy_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/top_bar_top"
            android:layout_marginEnd="@dimen/screen_pad"
            android:background="@drawable/bg_bili_badge"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- ============ 左下：作者 / 文案 / 音乐 ============
             没有底：压在视频上加一层蒙版会把画面切一块，抖音自己也是直接写字。
             字靠投影和画面分开，所以三行都要带上 shadow。
             宽度限死 520dp：再长会捅到右侧互动栏，一行的文案到这儿也够读了 -->
        <LinearLayout
            android:id="@+id/dy_info"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="28dp"
            android:layout_marginBottom="34dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dy_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dy_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dy_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ============ 右侧互动栏 ============ -->
        <LinearLayout
            android:id="@+id/dy_rail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dy_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_circle"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/dy_digg"
                style="@style/DyRailButton"
                android:contentDescription="点赞"
                android:src="@drawable/ic_dy_digg" />

            <TextView
                android:id="@+id/dy_digg_count"
                style="@style/DyRailLabel" />

            <ImageView
                android:id="@+id/dy_comment"
                style="@style/DyRailButton"
                android:contentDescription="评论"
                android:src="@drawable/ic_dy_comment" />

            <TextView
                android:id="@+id/dy_comment_count"
                style="@style/DyRailLabel" />

            <ImageView
                android:id="@+id/dy_collect"
                style="@style/DyRailButton"
                android:contentDescription="收藏"
                android:src="@drawable/ic_dy_collect" />

            <TextView
                android:id="@+id/dy_collect_count"
                style="@style/DyRailLabel" />

            <ImageView
                android:id="@+id/dy_login"
                style="@style/DyRailButton"
                android:contentDescription="登录"
                android:src="@drawable/ic_dy_login" />

            <!-- 搜索：纯遥控器用户走「长按确定」，这颗是给触屏/鼠标和「一眼看得见她能搜」用的 -->
            <ImageView
                android:id="@+id/dy_search"
                style="@style/DyRailButton"
                android:contentDescription="搜索"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <!-- 取列表 / 出错都写在这里：整页黑着的时候它是唯一一句说明 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/dy_loading"
                style="?android:attr/progressBarStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dy_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ 评论抽屉：从右边推出来，整块盖住互动栏 ============
         上下键被「换条」占着，所以这里滚不动，改成右键翻页（见 DouyinPage.showCommentPage）。
         底色必须不透明：半透明的话互动栏的数字会透出来压在评论文字上。 -->
    <LinearLayout
        android:id="@+id/dy_comments"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/dy_drawer_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="70dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dy_comments_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="评论"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dy_comments_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/dy_comments_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/dy_comments_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
