<?xml version="1.0" encoding="utf-8"?>
<!--
  音乐模块。坐标基准和桌面一致：1280×720dp（见 DeskAdaptActivity）。

  顶栏是音乐页自己的，不复用桌面那一条——桌面的页签是内容源的类目（电影/电视剧…），
  和音乐没有关系。但视觉语言照搬桌面：左上胶囊 + 居中亮底页签（bg_pill / bg_nav_item），
  从桌面切进来不该有「换了个 app」的观感。

  布局分三块：顶部栏 / 内容区（标题 + 列表）/ 底部播放条。
  播放条是常驻的，不随栏目切换消失——电视上「现在在放什么」必须一直看得见，
  否则用户切个栏目就不知道音乐还在不在放。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- 风格统一基准（同主界面/设置页）：desk_bg 底 + BackdropView 氛围光。
         模块页不许用纯色背景，从桌面点进来不能有「换了个 app」的感觉 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/desk_bg" />

    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      内容背景。跟着当前栏目/当前焦点那一行走：每日推荐用第一首的专辑封面，
      榜单用榜单封面，钻进歌单用那张歌单的封面。
      故意解码成一张一两百像素的小图再拉满屏——放大插值本身就是最便宜的模糊，
      不用引第三方 blur 库，也不吃 GPU。alpha 由代码控制（没有封面时淡出回氛围底）。
    -->
    <ImageView
        android:id="@+id/music_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <!-- MuYin 首页的两层压暗：左侧横向（保证 Hero 文字压得住亮图）+ 上下纵向
         （顶部压一点、中段透、底部压死给海报行）。不是整屏糊一层黑。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_scrim_h" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_scrim_v" />

    <!-- ============ 左上：音乐胶囊 ============ -->
    <!-- 坐标和桌面那颗「桌面 ▾」完全对齐（screen_pad / top_bar_top / top_bar_height）。
         点开是「返回桌面」——音乐页没有桌面顶栏了，这是回桌面的唯一常驻入口。 -->
    <LinearLayout
        android:id="@+id/music_switcher"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="@dimen/top_bar_top"
        android:background="@drawable/bg_glass_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/switcher_pad_h"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="@dimen/switcher_icon"
            android:layout_height="@dimen/switcher_icon"
            android:src="@drawable/ic_menu_list" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/switcher_gap"
            android:text="音乐"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- ============ 顶部中央：栏目 ============ -->
    <!-- 内容由代码动态填充（见 MusicPage.buildNav），写死会漏掉「音源」这类按功能加的项 -->
    <LinearLayout
        android:id="@+id/music_nav_items"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/top_bar_top"
        android:background="@drawable/bg_glass_surface"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/nav_pad_h"
        android:paddingEnd="@dimen/nav_pad_h" />

    <!-- ============ 右上：正在播放（播放条 / 播放页的直达入口） ============
         遥控器在长列表里按 DOWN 要一路按到最后一行才能落到播放条上，
         所以给一个常驻入口：确定键展开播放页，DOWN 直接跳到播放条的暂停键。
         样式沿用顶栏胶囊，和「音乐 ▾」「栏目」是一套语言。 -->
    <LinearLayout
        android:id="@+id/music_now_chip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/top_bar_top"
        android:layout_marginEnd="@dimen/screen_pad"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♪"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/music_now_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:text="正在播放"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- marginTop = top_bar_top + top_bar_height + 16 = 80dp：内容整块从顶栏下方开始。
         之前这里用 paddingTop + clipToPadding=false，卡片滚动时能画进 padding 区，
         整张封面直接压在左上角那颗「音乐▾」上（用户截图就是这个）。
         改成 marginTop 之后内容物理上就够不到顶栏，高度不变（padding 也在内容区内部占位）。 -->
    <LinearLayout
        android:id="@+id/music_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/content_top"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="37dp"
        android:paddingEnd="37dp">

        <!-- ============ Hero：kicker / 标题 / 元信息 / 简介 / 操作 ============
             尺寸全部照 MuYin 首页（960dp 画布）等比换算到我们的 1280dp：×4/3。
             竖直节奏也一样：kicker → 6 → 标题(61sp/行高69) → 4 → 元信息(17sp)
             → 6 → 简介(19sp/行高28, 两行) → 16 → 操作行(59dp 高)。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="41dp">

            <!-- kicker：小圆点 + 全大写感的说明（「正在播放 / 继续聆听 / 为你推荐」） -->
            <!-- 锚点缩略图：新版 Hero 直接用整屏封面，这张不再显示；
                 保留节点是因为 MusicPage/BiliPage 里有 bindHeadCover() 在维护它 -->
            <ImageView
                android:id="@+id/music_head_cover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/music_hero_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_hero_dot" />

                <TextView
                    android:id="@+id/music_hero_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:letterSpacing="0.16"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="12"
                    android:text="为你推荐"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/music_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="-0.022"
                android:maxLines="1"
                android:maxWidth="827dp"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text="每日推荐"
                android:textColor="@color/text_primary"
                android:textSize="61sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/music_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/music_hero_desc"
                android:layout_width="747dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="5dp"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text=""
                android:textColor="#ADFFFFFF"
                android:textSize="19sp" />

            <!-- 操作行：主按钮 176×59 圆角 29 + 三颗 59dp 圆钮（间距 13/11/24） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_play_all"
                    android:layout_width="176dp"
                    android:layout_height="59dp"
                    android:background="@drawable/bg_hero_cta"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:text="播放全部"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/music_action_prev"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_prev" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/music_action_next"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_next" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/music_action_fav"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/music_action_fav_icon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_like" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/music_action_stage"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_expand" />
                </FrameLayout>

                <!-- 只在「搜索」栏目露出来（MusicPage 控制显隐） -->
                <EditText
                    android:id="@+id/music_search"
                    android:layout_width="560dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="搜歌名 / 歌手 / 专辑"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:singleLine="true"
                    android:textColor="#F5F7FA"
                    android:textColorHint="#6F7280"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 弹性空档：卡片模式下把海报行顶到底部（桌面首页就是这么分的：
             Hero 在上、海报行在下、中间留给背景画面）。列表模式下权重归零，由列表吃掉空间 -->
        <View
            android:id="@+id/music_top_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          行列表要外面套一层「裁剪盒」，原因在 clipToPadding：
          ListView 自己 clipToPadding=false 时，滚动的行会画到自己的边界之外（padding 区、
          甚至顶边以上）。父容器 music_content 的 clipChildren 默认放过它，
          于是第一行会直接盖到「音源市场」那个副标题上（用户截图就是这个）。
          套一层 FrameLayout 并让它 clipChildren=true，滚动内容就只能在盒子里走：
          上边不再压标题，下边仍然可以滚到悬浮播放条底下（盒子一直到底）。
        -->
        <FrameLayout
            android:id="@+id/music_list_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:clipChildren="true"
            android:clipToPadding="false">

            <!-- paddingBottom 让最后一行不被悬浮播放条压住（条高 92 + 离底 safe_bottom 44，再留 16 的视觉空隙） -->
            <ListView
                android:id="@+id/music_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="152dp"
                android:scrollbars="none" />
        </FrameLayout>

        <!--
          内容卡片墙。和影视页的海报墙同参数（6 列 / 20dp 横距 / 24dp 行距 / 透明 selector），
          聚焦放大和错峰入场也走同一套 FocusScaler + RevealAnim。
          只有「音源管理」这种设置型列表还用上面的 music_list。
        -->
        <!-- 段落头：粗体标题 + 灰色说明，和桌面首页海报行的小标题同一条横线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text="每日推荐"
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/music_row_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text=""
                android:textColor="#94FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 底部海报行：一行、横向滚动（桌面首页「今日热门」同款）。
             以前是 6 列纵向卡片墙，和桌面首页不是一套观感；换成一行之后
             Hero 在上、海报在下，中间留出背景画面。 -->
        <com.tvdesk.desk.widget.TileRow
            android:id="@+id/music_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="18dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/music_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============ 底部：悬浮播放条 ============ -->
    <!--
      不再是通栏的一条底栏，而是浮在内容上面的一枚胶囊（左右下各留边 + bg_music_bar）。
      通栏那条会把卡片墙最后一行「切掉」，悬浮条后面还能看见滚过去的海报，
      电视上这一层浮起也顺便说明了「这是常驻的播放器，不是当前栏目的一部分」。

      六个按钮从左到右：播放方式 / 上一首 / 暂停 / 下一首 / 收藏 / 展开。
      两个状态类按钮（方式、收藏）分在传输键两侧，按的时候手不会顺路撞到你刚改的东西。
    -->
    <LinearLayout
        android:id="@+id/music_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/safe_side"
        android:layout_marginEnd="@dimen/safe_side"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_music_bar"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <!--
          圆形封面。本地歌多半没有封面，底下先垫一个音符：空心的圆看着像图没加载出来，
          有音符才读得出「这首歌就是没有封面」。
        -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp">

            <TextView
                android:id="@+id/music_now_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="♪"
                android:textColor="#66FFFFFF"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/music_now_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_music_bar_cover"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/music_now_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/music_now_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/music_mode"
            style="@style/MusicControlIcon"
            android:layout_marginStart="16dp"
            android:contentDescription="播放方式"
            android:src="@drawable/ic_mode_order" />

        <ImageView
            android:id="@+id/music_prev"
            style="@style/MusicControlIcon"
            android:contentDescription="上一首"
            android:src="@drawable/ic_prev" />

        <ImageView
            android:id="@+id/music_toggle"
            style="@style/MusicControlIcon"
            android:contentDescription="暂停"
            android:src="@drawable/ic_pause" />

        <ImageView
            android:id="@+id/music_next"
            style="@style/MusicControlIcon"
            android:contentDescription="下一首"
            android:src="@drawable/ic_next" />

        <ImageView
            android:id="@+id/music_like"
            style="@style/MusicControlIcon"
            android:contentDescription="收藏"
            android:src="@drawable/ic_like" />

        <!-- 展开沉浸播放页。放在最后一个：它是这一排里唯一「离开这一排」的动作，
             按遥控器习惯就该排在顺着往右的尽头 -->
        <ImageView
            android:id="@+id/music_expand"
            style="@style/MusicControlIcon"
            android:contentDescription="展开播放页"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <!--
      音乐胶囊下拉（默认收起）。必须放在 root 的最后一个子节点：
      FrameLayout 按子节点顺序绘制，放在内容层前面就会被 32sp 的页面标题压在下面。
      elevation 在 minSdk 19 上不保证生效，所以用顺序而不是层级。
    -->
    <LinearLayout
        android:id="@+id/music_menu"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <!--
      沉浸播放页。必须在 root 的最后一个子节点：它要盖住上面所有内容（包括胶囊下拉）。
      默认收起，由播放条最右边那个「展开」按钮打开。
    -->
    <include
        android:id="@+id/music_stage"
        layout="@layout/view_music_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
