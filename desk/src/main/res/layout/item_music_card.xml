<?xml version="1.0" encoding="utf-8"?>
<!--
  音乐卡片。和影视页 item_tv_poster 同一套语言：
  外框画聚焦白边、图片内缩 3dp 再裁圆角、下面两行文字。
  区别只在比例——专辑/歌单封面是方的，所以图框锁 180dp 高（列宽约 180dp）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/music_card_frame"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_poster"
        android:duplicateParentState="true"
        android:padding="3dp">

        <!-- 没有封面时的底。在线专辑图到了会被 ImageView 盖住 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover_placeholder" />

        <!-- 本地曲目/分组没有封面，用一个字符占位，比一块空灰块有信息量。
             放在 ImageView 下层：有图时被盖住，没图时透出来 -->
        <TextView
            android:id="@+id/music_card_ph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:text="♪"
            android:textColor="#5CFFFFFF"
            android:textSize="54sp" />

        <ImageView
            android:id="@+id/music_card_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/music_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#F2F5FA"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/music_card_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#8A93A6"
        android:textSize="14sp" />
</LinearLayout>
