<?xml version="1.0" encoding="utf-8"?>
<!--
  设置卡片。和其它模块的卡片同一套语言：16:9 圆角面板，聚焦放大 + 白环。
  一张卡 = 一个设置项：标题（是什么）、当前值（现在什么状态）、说明（按下去会发生什么）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@drawable/bg_poster"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:padding="3dp">

    <!-- 底板：bg_poster 只负责聚焦白框，真正压住背景的是这一层 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cover_placeholder"
        android:duplicateParentState="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/settings_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_card_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFD166"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/settings_card_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
