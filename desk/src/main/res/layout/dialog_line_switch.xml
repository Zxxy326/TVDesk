<?xml version="1.0" encoding="utf-8"?>
<!--
  播放中长按 OK 弹出的线路选择。

  和首页长按换源弹窗（dialog_source_switch）长得一样，但管的是另一层：
  这里列的是当前这部片子在源里带的线路（seriesFlags），包括网盘的「夸克」「阿里」那些。
  换线路只改 VodInfo.playFlag，不碰全局的内容源。

  列表固定 236dp：线路一般十来条，wrap_content 会把底下的取消按钮顶出面板，
  超出部分靠焦点自动滚动带出来。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="620dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选择线路"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/line_switch_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/line_switch_scroll"
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:layout_marginTop="14dp"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/line_switch_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/line_switch_btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_btn"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="取消"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="切换后接着当前这一集播放；网盘线路（夸克、阿里等）也在列表里"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
