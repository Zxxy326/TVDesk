<?xml version="1.0" encoding="utf-8"?>
<!--
  B 站播放页。

  为什么不用 ExoPlayer 自带的控制条（PlayerView 的 use_controller）：
  它按手机触屏的思路排，焦点进不去、字号和配色也是 Material 那一套，
  和这个 App 自绘的桌面语言对不上。所以这里 use_controller=false，
  底下自己有一条悬浮胶囊控制条——和音乐页的「现在播放」同款底、同款传输键。

  层序从下往上：黑底 → 画面 → 弹幕 → 顶部标题 → 底部胶囊。
  弹幕层不接收触摸/焦点（clickable=false），否则会挡住控制条的按键。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/bili_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <master.flame.danmaku.ui.widget.DanmakuView
        android:id="@+id/bili_danmaku"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 顶部：标题 + 清晰度。半透明压暗层保证白字在亮画面上也读得出 -->
    <LinearLayout
        android:id="@+id/bili_player_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="26dp"
        android:paddingEnd="40dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/bili_player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bili_player_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ============ 底部悬浮胶囊（和音乐页同款） ============ -->
    <LinearLayout
        android:id="@+id/bili_controls"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_music_bar"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/bili_pos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="0:00"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 进度条和音乐播放页同款：细轨道 + 白圆点。这里只读不拖——
             遥控器逐格拖不如长按左右键来得准，快退快进取 15/30/60 秒递增。
             配色保留品牌粉（在 BiliPlayerPage 里 setColors）。 -->
        <com.tvdesk.desk.widget.WaveProgressView
            android:id="@+id/bili_seek"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/bili_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="0:00"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/bili_mode"
            style="@style/MusicControlIcon"
            android:contentDescription="连播模式"
            android:src="@drawable/ic_mode_sequence" />

        <ImageView
            android:id="@+id/bili_toggle"
            style="@style/MusicControlIcon"
            android:contentDescription="暂停"
            android:src="@drawable/ic_pause" />

        <TextView
            android:id="@+id/bili_danmu"
            style="@style/MusicControl"
            android:text="弹幕 开" />

        <TextView
            android:id="@+id/bili_settings"
            style="@style/MusicControl"
            android:text="设置" />
    </LinearLayout>

    <!-- 只在取流时转圈；错误和播放结束走 Toast，不在画面中间压一行字 -->
    <ProgressBar
        android:id="@+id/bili_player_loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
