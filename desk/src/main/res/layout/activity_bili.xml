<?xml version="1.0" encoding="utf-8"?>
<!--
  哔哩哔哩模块页。坐标基准和桌面/音乐页一致：1280×720dp（见 DeskAdaptActivity）。

  顶栏是本页自己的（桌面的页签是内容源的类目，和 B 站无关），视觉语言照搬桌面：
  左上胶囊 + 居中亮底页签（bg_pill / bg_nav_item）+ FocusScaler 1.06。

  和音乐页多了一层「子页签」（bili_sub_nav）：排行榜要按分区切，直播要按直播分区切。
  它不放顶栏是因为宽度——分区名连排能到十几个，顶栏胶囊塞不下。

  内容一律铺卡片墙（和影视页/音乐页同一套），没有 ListView：
  B 站没有「设置型列表」这种需要行式的版块，登录入口也用卡片表达。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/desk_bg" />

    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 整页背景。跟着当前聚焦那张卡的封面走，alpha 由代码控制（无封面时淡出回氛围底） -->
    <ImageView
        android:id="@+id/bili_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="fitCenter" />

    <!-- MuYin 首页同款两层压暗 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_scrim_h" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_scrim_v" />

    <!-- ============ 左上：模块胶囊 ============ -->
    <!-- 坐标和桌面那颗「桌面 ▾」完全对齐。点开是「返回桌面」——本页没有桌面顶栏，这是唯一常驻出口 -->
    <LinearLayout
        android:id="@+id/bili_switcher"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="@dimen/top_bar_top"
        android:background="@drawable/bg_glass_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/switcher_pad_h"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="@dimen/switcher_icon"
            android:layout_height="@dimen/switcher_icon"
            android:src="@drawable/ic_menu_list" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/switcher_gap"
            android:text="哔哩哔哩"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- ============ 顶部中央：栏目 ============ -->
    <LinearLayout
        android:id="@+id/bili_nav_items"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/top_bar_top"
        android:background="@drawable/bg_glass_surface"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/nav_pad_h"
        android:paddingEnd="@dimen/nav_pad_h" />

    <!--
      内容层。clipChildren 这里必须保持默认的「裁剪」：墙整行翻上去时，
      滚出边界的卡片会被画到内容层外面，不裁剪就直接压在页面标题和顶栏上。
      卡片焦点放大 1.08 的溢出量由墙自己的 paddingTop（以及左右 -12dp 负边距配 12dp 内边距）吸收。
      顶距用 marginTop 而不是 paddingTop：padding 会被 clipToPadding=false 放出来，
      卡片会画到顶栏上把左上角那颗「哔哩哔哩▾」盖住（音乐页也是这个问题）。
    -->
    <LinearLayout
        android:id="@+id/bili_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/content_top"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="37dp"
        android:paddingEnd="37dp">

        <!-- ============ Hero：kicker / 标题 / 元信息 / 简介 / 操作 ============
             和音乐页同一套（都按 MuYin 首页 ×4/3 换算） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="41dp">

            <!-- 锚点缩略图：新版 Hero 直接用整屏封面，这张不再显示；
                 保留节点是因为 MusicPage/BiliPage 里有 bindHeadCover() 在维护它 -->
            <ImageView
                android:id="@+id/bili_head_cover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_hero_dot" />

                <TextView
                    android:id="@+id/bili_hero_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:letterSpacing="0.16"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="12"
                    android:text="为你推荐"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/bili_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="-0.022"
                android:maxLines="1"
                android:maxWidth="827dp"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text="推荐"
                android:textColor="@color/text_primary"
                android:textSize="61sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bili_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/bili_hero_desc"
                android:layout_width="747dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="5dp"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text=""
                android:textColor="#ADFFFFFF"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bili_hero_cta"
                    android:layout_width="176dp"
                    android:layout_height="59dp"
                    android:background="@drawable/bg_hero_cta"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:text="开始观看"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/bili_action_like"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_like" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/bili_action_author"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_author" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/bili_action_refresh"
                    android:layout_width="59dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_hero_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh" />
                </FrameLayout>

                <!-- 只在「搜索」栏目露出来（BiliPage 控制显隐） -->
                <EditText
                    android:id="@+id/bili_search"
                    android:layout_width="560dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="搜视频 / UP 主 / BV 号"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:singleLine="true"
                    android:textColor="#F5F7FA"
                    android:textColorHint="#6F7280"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!--
          子页签（排行榜的分区 / 直播的分区）。横向可滚：分区连排有十几个，
          一屏放不下，切焦点时由代码把它滚进视口。
          负 margin 和卡片墙同理——焦点放大 1.06 会不会切掉边缘取决于祖先链有没有 clip，
          这里的 clipChildren=false 一路给到 root。
        -->
        <HorizontalScrollView
            android:id="@+id/bili_sub_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/bili_sub_nav"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_surface"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </HorizontalScrollView>

        <!-- 卡片墙。参数和影视页/音乐页一致：6 列 / 20dp 横距 / 24dp 行距。
             不再是 GridView（回收子视图 → 焦点没主 → 「翻页跳左上角」），
             换成全量挂载的 TileWall；列数和间距在 BiliPage.setupGrid 里给。 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text="推荐给你"
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bili_row_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text=""
                android:textColor="#94FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 弹性空档：把海报行顶到底部（桌面首页 Hero 在上、海报行在下的排法） -->
        <View
            android:id="@+id/bili_top_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部海报行：一行、横向滚动（桌面首页「今日热门」同款） -->
        <com.tvdesk.desk.widget.TileRow
            android:id="@+id/bili_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/bili_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 首屏加载中：卡片墙空着的时候给一个明确的「在等」，不然是黑屏 -->
    <ProgressBar
        android:id="@+id/bili_loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!--
      胶囊下拉（默认收起）。必须放在 root 的最后一个子节点：
      FrameLayout 按子节点顺序绘制，放在内容层前面就会被 32sp 的页面标题压在下面。
      elevation 在 minSdk 19 上不保证生效，所以用顺序而不是层级。
    -->
    <LinearLayout
        android:id="@+id/bili_menu"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

</FrameLayout>
