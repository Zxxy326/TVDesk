<?xml version="1.0" encoding="utf-8"?>
<!--
  内嵌详情页。左侧海报 + 右侧元信息/线路/选集，播放交给宿主盖一层播放器。

  右列的所有控件都紧贴内容区左边界（x=308dp），而焦点态会放大 1.06 倍，
  放大部分必然越过这条边界。所以从根节点到按钮行整条链都要 clipChildren=false，
  否则放大的那一圈会被父容器按边界切平——表现就是播放键/线路 chip 左侧像被削掉一块。
  线路横滚和选集网格再各自留出内边距（配合负 margin 回正），让缩放有地方画。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desk_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/detail_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="34dp"
        android:paddingEnd="56dp"
        android:paddingBottom="@dimen/safe_bottom">

        <TextView
            android:id="@+id/detail_crumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="影视 / 详情"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="315dp"
                android:background="@drawable/bg_poster"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/detail_poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="42dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#F5F7FA"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detail_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="4"
                    android:textColor="#C2C7D2"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/detail_play"
                        android:layout_width="72dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_btn_primary"
                        android:clickable="true"
                        android:contentDescription="播放"
                        android:focusable="true"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_dark" />

                    <!-- 收藏。以前只有首页那颗「简介旁边的星」能收，从搜索/收藏/历史点进来的
                         详情页反而收不了 —— 用户看到一部想留的片子，得先退回首页去找。
                         放在播放右边，是这一行第二个动作。 -->
                    <TextView
                        android:id="@+id/detail_fav"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pill"
                        android:clickable="true"
                        android:contentDescription="收藏"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="104dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="收藏"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_search"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="118dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="搜索片源"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="88dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="重试"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_line_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="线路"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <!--
                  6dp 内边距 + 负 margin：chip 的实际位置不变，但横滚区向外多出 6dp。
                  聚焦放大的约 3dp 画在这段内边距里，不会被横滚区自己的边界切掉；
                  滚动时滚出去的内容也只多露出 6dp，仍在内容列的留白里。
                -->
                <HorizontalScrollView
                    android:id="@+id/detail_line_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="-6dp"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:overScrollMode="never"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/detail_lines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!--
                  选集区：ScrollView + GridLayout。

                  为什么不是 GridView：GridView 是 AbsListView，高度一旦被钉死成
                  几行（height=0dp + weight=1），焦点走到最后一行再按「下」就不会
                  再滚 —— 199 集的剧只能看到前 32 集，后面的集数在电视上等于不存在。
                  想让它按内容撑开又得塞进 ScrollView，而 AbsListView 在
                  ScrollView 的 UNSPECIFIED 测量下会在 fillDown 里空指针崩掉（踩过）。
                  所以换成 GridLayout：它不是滚动容器，高度天然按内容算，
                  外面套 ScrollView 就能一路翻；焦点移动时 ScrollView 自己会跟。
                -->
                <!--
                  选集标题 + 分段条。
                  集数一多（比如 199 集）光靠方向键一路往下按太费劲，
                  这里按 30 集切一段，点一下直接跳到那一段。
                  集数不到一屏时不显示，免得凑一排没用的按钮。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_episode_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textColor="@color/text_tertiary"
                        android:textSize="13sp" />

                    <HorizontalScrollView
                        android:id="@+id/detail_chunk_scroll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/detail_episode_chunks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!--
                  选集：固定高度网格 + 上方的分段条翻页。

                  为什么不是「可滚动的长网格」：试过两种都不行 ——
                  GridView 高度一固定就翻不了页（199 集只能看到前 32 集），
                  塞进 ScrollView 又在 AbsListView 的 UNSPECIFIED 测量里空指针崩溃；
                  换成 ScrollView + GridLayout 虽然能滚，但这台电视上滚动时
                  整页会出现重影（集数画到了标题和简介上）。

                  最终按用户提的交互来做：一屏只放 32 集（8 列 × 4 行，正好一页），
                  想看后面就用上面的分段条（1-30 / 31-60 …）翻页。
                  不滚动 = 上面那些渲染问题一个都不会出现。
                -->
                <com.tvdesk.desk.widget.PageGridView
                    android:id="@+id/detail_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="204dp"
                    android:layout_marginStart="-10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="-10dp"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:horizontalSpacing="10dp"
                    android:numColumns="8"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detail_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#B9B9C2"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
