<?xml version="1.0" encoding="utf-8"?>
<!--
  内嵌详情页。左侧海报 + 右侧元信息/线路/选集，播放交给宿主盖一层播放器。

  右列的所有控件都紧贴内容区左边界（x=308dp），而焦点态会放大 1.06 倍，
  放大部分必然越过这条边界。所以从根节点到按钮行整条链都要 clipChildren=false，
  否则放大的那一圈会被父容器按边界切平——表现就是播放键/线路 chip 左侧像被削掉一块。
  线路横滚和选集网格再各自留出内边距（配合负 margin 回正），让缩放有地方画。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desk_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/detail_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="34dp"
        android:paddingEnd="56dp"
        android:paddingBottom="@dimen/safe_bottom">

        <TextView
            android:id="@+id/detail_crumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="影视 / 详情"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="315dp"
                android:background="@drawable/bg_poster"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/detail_poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="42dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#F5F7FA"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detail_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="4"
                    android:textColor="#C2C7D2"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/detail_play"
                        android:layout_width="72dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_btn_primary"
                        android:clickable="true"
                        android:contentDescription="播放"
                        android:focusable="true"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_dark" />

                    <TextView
                        android:id="@+id/detail_search"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="118dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="搜索片源"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="88dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="重试"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_line_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="线路"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <!--
                  6dp 内边距 + 负 margin：chip 的实际位置不变，但横滚区向外多出 6dp。
                  聚焦放大的约 3dp 画在这段内边距里，不会被横滚区自己的边界切掉；
                  滚动时滚出去的内容也只多露出 6dp，仍在内容列的留白里。
                -->
                <HorizontalScrollView
                    android:id="@+id/detail_line_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="-6dp"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:overScrollMode="never"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/detail_lines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/detail_episode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="选集"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <!-- 左右各留 10dp（配负 margin 回正）：第一列/最后一列聚焦放大时不再贴边被切 -->
                <GridView
                    android:id="@+id/detail_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="-10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="-10dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:horizontalSpacing="10dp"
                    android:numColumns="8"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="none"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detail_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#B9B9C2"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
