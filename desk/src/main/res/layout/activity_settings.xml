<?xml version="1.0" encoding="utf-8"?>
<!--
  TVDesk 设置页（独立 Activity，从桌面的「桌面 ▾ → 设置」或顶栏提示条进来）

  设计画布：1280x720dp（1920x1080 @ density 1.5，见 AndroidManifest 的 design_width_in_dp）
  层级：桌面 › 设置 › 配置地址弹窗。面包屑在最上面把这件事说明白，返回键逐层退出。

  分两组：
    内容源 —— 当前源（只读）/ 配置地址（点开弹窗：输入或选历史）
    系统   —— 系统设置（跳到电视原生设置，不是 TVBox 的设置页）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/desk_bg" />

    <!-- 和桌面同一套氛围底，从桌面点进来不该有「换了个 app」的感觉 -->
    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad"
            android:paddingTop="28dp"
            android:paddingEnd="@dimen/screen_pad"
            android:paddingBottom="28dp">

            <!-- ============ 面包屑：说明「我在哪、从哪来的、按返回去哪」 ============ -->
            <LinearLayout
                android:id="@+id/crumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/settings_crumb_desk"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/settings_crumb_size" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/settings_crumb_size" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="-0.02"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_title_size"
                android:textStyle="bold" />

            <!-- ============ 分组：内容源 ============ -->
            <LinearLayout
                android:layout_width="@dimen/settings_panel_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_settings_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="10dp"
                    android:text="@string/settings_group_source"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/settings_group_size" />

                <!-- 只读行：当前生效的源。背景更暗、点不动，和下面能点进去的行区分开 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_setting_readonly"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/settings_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/settings_row_pad_h"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/settings_row_pad_h"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_current_source"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/settings_item_size" />

                        <TextView
                            android:id="@+id/source_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_source_none_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/settings_note_size" />
                    </LinearLayout>

                    <!-- 地址可能很长，中间省略：头和尾往往都比中间有信息量 -->
                    <TextView
                        android:id="@+id/source_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:ellipsize="middle"
                        android:maxWidth="420dp"
                        android:singleLine="true"
                        android:text="@string/settings_source_none"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/settings_value_size" />
                </LinearLayout>

                <!-- 入口行：配置地址 -->
                <LinearLayout
                    android:id="@+id/row_edit_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/settings_row_gap"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/settings_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/settings_row_pad_h"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/settings_row_pad_h"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_edit_source"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/settings_item_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_edit_source_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/settings_note_size" />
                    </LinearLayout>

                    <!-- 值已经在上面「当前源」那行显示过了，这里只放一个「点得进去」的箭头 -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 分组：播放 ============ -->
            <LinearLayout
                android:layout_width="@dimen/settings_panel_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_settings_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="10dp"
                    android:text="@string/settings_group_play"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/settings_group_size" />

                <!-- 开关行：整行可点，右侧药丸就是当前取值，不需要再弹一层 -->
                <LinearLayout
                    android:id="@+id/row_keep_playing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/settings_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/settings_row_pad_h"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/settings_row_pad_h"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_keep_playing"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/settings_item_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_keep_playing_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/settings_note_size" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/keep_playing_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_setting_switch"
                        android:gravity="center"
                        android:minWidth="104dp"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="@string/settings_switch_off"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/settings_value_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 分组：系统 ============ -->
            <LinearLayout
                android:layout_width="@dimen/settings_panel_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_settings_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="10dp"
                    android:text="@string/settings_group_system"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/settings_group_size" />

                <!-- 入口行：跳电视原生设置 -->
                <LinearLayout
                    android:id="@+id/row_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/settings_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/settings_row_pad_h"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/settings_row_pad_h"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_system"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/settings_item_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_system_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/settings_note_size" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 底部说明：把「按了应用之后会发生什么」讲清楚 ============ -->
            <TextView
                android:layout_width="@dimen/settings_panel_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:drawablePadding="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/settings_footnote"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/settings_hint_size" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
