<?xml version="1.0" encoding="utf-8"?>
<!--
  TVDesk 设置页。

  结构和其它模块一致（音乐 / B 站 / 应用）：左上角一颗胶囊 + 中间一排页签 + 下面卡片墙，
  不再是「两列设置行」那种桌面软件的样子。这样设置页和其它模块共用同一套焦点与动画，
  返回、聚焦、翻页的手感也一致。

  分组用页签：播放 / 桌面 / 关于。每组两三张卡，一屏放得下，不需要滚动。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏：胶囊 + 页签 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="@dimen/top_bar_top"
        android:paddingEnd="@dimen/screen_pad">

        <LinearLayout
            android:id="@+id/settings_switcher"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_height"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/switcher_pad_h"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="@dimen/switcher_icon"
                android:layout_height="@dimen/switcher_icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_menu_list" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/switcher_gap"
                android:text="设置"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- 页签由代码填（播放 / 桌面 / 关于） -->
        <LinearLayout
            android:id="@+id/settings_nav_items"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_height"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_pill"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/nav_pad_h"
            android:paddingEnd="@dimen/nav_pad_h" />
    </LinearLayout>

    <!-- 卡片墙。三列 16:9，参数和音乐页一致，只是列少一些（设置项宽一点更好读） -->
    <com.tvdesk.desk.widget.TileWall
        android:id="@+id/settings_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="104dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingBottom="24dp" />
</FrameLayout>
