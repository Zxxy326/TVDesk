<?xml version="1.0" encoding="utf-8"?>
<!--
  请选择首页数据源。

  和 TVBox 原版的同名弹窗对齐：换的是**当前配置（线路）里 sites 的某一项**，
  不是配置地址本身。两列是参考稿的做法——电视上横向多一列比竖向多一行好扫。
  每个格子 46dp，最多露五行，更多的靠焦点滚动带出来。

  底部只留两条出路：「换线路 / 配置地址」通向旧的 SourceSwitchDialog，
  「取消」和 BACK 都不改任何东西。数据源列表为空时整块换成一句解释，不留死胡同。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="760dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请选择首页数据源"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_source_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 负 margin 配内边距：首列/末列聚焦放大时不会被网格自身边界切掉 -->
    <GridView
        android:id="@+id/home_source_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="-6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:horizontalSpacing="12dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="2"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp" />

    <TextView
        android:id="@+id/home_source_empty"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="4dp"
        android:text="这份配置里还没有可用的数据源。\n先「换线路 / 配置地址」填一个能拉到站点列表的地址。"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/home_source_btn_lines"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="换线路 / 配置地址"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_source_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="这一层只换本条配置里的数据源；要换配置线路或改地址，走左边那一项"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
