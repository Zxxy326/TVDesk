<?xml version="1.0" encoding="utf-8"?>
<!-- 内嵌搜索页：上面片名输入，左边遥控器键盘，右边结果墙 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/desk_bg" />

    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="@dimen/safe_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textColor="#F5F7FA"
                android:textSize="@dimen/module_title_size"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="输入片名，可用语音输入"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:textColor="#F5F7FA"
                android:textColorHint="#6F7280"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/search_go"
                android:layout_width="72dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:contentDescription="搜索"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search_dark" />
        </LinearLayout>

        <!-- 最近搜索：进搜索页就会自动弹输入法，历史退居到输入框下面的一行，
             不再占左边半屏。只留文字条，搜过的词一点就回来。 -->
        <LinearLayout
            android:id="@+id/search_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="最近搜索"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <!-- 四周留 8dp：条目按 1.06 放大时左右各溢出约 6dp，
                 不留的话描边会被父容器切平 —— 表现就是焦点框左右两侧是直边。 -->
            <LinearLayout
                android:id="@+id/search_history_words"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 焦点留白同其它模块的墙（wall_room_*） -->
            <com.tvdesk.desk.widget.TileWall
                android:id="@+id/search_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="-14dp"
                android:layout_marginTop="-16dp"
                android:layout_marginEnd="-14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp" />

            <ProgressBar
                android:id="@+id/search_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/search_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#8A93A6"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="进入即弹输入法，直接打字或用语音；按「下」进结果墙，返回键收起输入法。"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
