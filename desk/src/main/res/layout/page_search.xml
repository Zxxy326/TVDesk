<?xml version="1.0" encoding="utf-8"?>
<!-- 内嵌搜索页：上面片名输入，左边遥控器键盘，右边结果墙 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/desk_bg" />

    <com.tvdesk.desk.widget.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="@dimen/safe_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textColor="#F5F7FA"
                android:textSize="@dimen/module_title_size"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="输入片名，或用左边的键盘"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:textColor="#F5F7FA"
                android:textColorHint="#6F7280"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/search_go"
                android:layout_width="72dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:contentDescription="搜索"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search_dark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- 左边一列：键盘 + 键盘下面的「最近搜索」。
                 键盘宽度从 560dp 收到 430dp：键盘是输入工具，不是内容，
                 占掉半屏之后右边结果区只剩 4 张小卡。 -->
            <LinearLayout
                android:layout_width="430dp"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:orientation="vertical">

                <!-- 6 列字母键盘由代码生成；宽度跟着这一列走 -->
                <LinearLayout
                    android:id="@+id/search_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 最近搜索：电视上打字贵，搜过的词直接点回来。
                     只留文字（没有底卡片），是因为它就贴在键盘下面 ——
                     再来一排带底的按钮，视觉上会跟键盘的按键混成一片。 -->
                <LinearLayout
                    android:id="@+id/search_history"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="最近搜索"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />

                    <!-- 四周留 8dp：条目按 1.06 放大时左右各溢出约 6dp，
                         不留的话描边会被这一列（clipChildren=true）切平 ——
                         表现就是焦点框左右两侧是直边、像被裁掉。 -->
                    <LinearLayout
                        android:id="@+id/search_history_words"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 焦点留白同其它模块的墙（wall_room_*） -->
                <com.tvdesk.desk.widget.TileWall
                    android:id="@+id/search_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-14dp"
                    android:layout_marginTop="-16dp"
                    android:layout_marginEnd="-14dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp" />

                <ProgressBar
                    android:id="@+id/search_loading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/search_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="#8A93A6"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="遥控器：焦点默认在片名框，按「下」进字母键盘；确定输入。片名框上按确定可调出输入法打中文。"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
