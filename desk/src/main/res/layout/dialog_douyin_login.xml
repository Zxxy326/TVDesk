<?xml version="1.0" encoding="utf-8"?>
<!--
  抖音「登录」弹窗。

  和 B 站那个的差别：B 站有能用的扫码接口，抖音没有——网页端登录全走
  passport.douyin.com 的滑块风控，第三方无从下手。所以这里的二维码不是「扫码授权」，
  而是「扫码打开本机那个局域网表单页」：手机扫开，把浏览器里的 cookie 粘进去提交，
  电视当场收下。本质上还是粘 cookie，只是键盘换成了手机，遥控器不用逐字敲两三 KB。

  三条出路，一条都不许堵死（同音乐页那条规矩）：
    1. 扫二维码 → 局域网表单（最顺手）。
    2. 下面输入框直接粘（二维码刷不出来、或者 TV 和电脑不在同一个网段时）。
    3. 取消 / 清除登录 —— 进来看一眼发现麻烦，能原路退出，也不留着上一次的 cookie。

  高度跟着内容走、二维码那块给固定高度：地址拿不到时要把二维码整块收掉，
  面板写死高度就会在中间留下半屏空白。窗口本身是 WRAP_CONTENT，按钮不会被裁。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/settings_dialog_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="登录抖音"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/douyin_login_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="正在启动本机推送服务…"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/settings_note_size" />

    <!-- ============ 二维码 ============ -->
    <FrameLayout
        android:id="@+id/douyin_login_qr_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <!-- 白底：深模块浅底才扫得出来，压在深色面板上手机对不上焦 -->
        <FrameLayout
            android:id="@+id/douyin_login_qr_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:padding="10dp">

            <ImageView
                android:id="@+id/douyin_login_qr"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:contentDescription="@null"
                android:focusable="false" />
        </FrameLayout>
    </FrameLayout>

    <!-- 二维码对应的地址，同网段手动输入用的上（手机扫不动时至少有个能抄的串） -->
    <TextView
        android:id="@+id/douyin_login_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ============ 手动粘 cookie ============ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="或者把浏览器里的抖音 cookie 直接粘这里（要含 UIFID 或 sessionid）"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/settings_note_size" />

    <EditText
        android:id="@+id/douyin_login_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="UIFID=…; sessionid=…; ttwid=…"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="2"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textCursorDrawable="@null"
        android:textSize="13sp" />

    <!-- ============ 按钮 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/douyin_login_clear"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="清除登录"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/dialog_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/settings_action_cancel"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/douyin_login_apply"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="用这段 cookie"
            android:textColor="@color/text_on_light"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
