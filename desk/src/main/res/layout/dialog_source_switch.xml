<?xml version="1.0" encoding="utf-8"?>
<!--
  首页长按换源弹窗。

  内容只有两件事：现在用的是哪个源，以及还能换成什么。
  多线路放在最上面（配置里带 urls 时才有），后面是用过的源；
  底部四个动作都有明确出路，「取消」和 BACK 都不改任何配置。

  列表固定 236dp（约五行）：电视上的窗口高度上限约 500dp，
  让它 wrap_content 的话线路一多，底下的按钮行会被面板底边裁掉。
  超出的行靠焦点滚动带出来，和 SourceDialog 一个处理方式。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="620dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="切换线路"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/source_switch_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/source_switch_scroll"
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:layout_marginTop="14dp"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/source_switch_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/source_switch_empty"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="4dp"
        android:text="还没有用过的源 · 点下面「配置地址…」，填一个接口地址就能开始"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/source_switch_btn_refresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="刷新当前源"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/source_switch_btn_config"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="配置地址…"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/source_switch_btn_signal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="信号源页"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/source_switch_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="需要带 Cookie 或参数的源，进「配置地址」直接粘贴完整地址即可"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
