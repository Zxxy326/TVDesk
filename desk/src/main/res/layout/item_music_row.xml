<?xml version="1.0" encoding="utf-8"?>
<!--
  音乐列表的一行。歌曲和分组（歌手/专辑/文件夹）共用：
  分组行只有标题和右侧计数，没有副标题，把副标题隐藏即可。

  行本身可聚焦——ListView 必须 setItemsCanFocus(true) 才会把焦点交给子项。
  焦点语言沿用设置页那套（bg_setting_row：亮底 + 白描边）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_setting_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!--
      行封面。在线曲目是专辑图，歌单/榜单行是歌单封面；本地曲库和分组行没有封面，
      只留这块占位底——不占的话有封面和没封面的行文字起点对不齐，一列看下去像锯齿。
    -->
    <ImageView
        android:id="@+id/music_row_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_cover_placeholder"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/music_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/music_row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/music_row_tail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text=""
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

</LinearLayout>
