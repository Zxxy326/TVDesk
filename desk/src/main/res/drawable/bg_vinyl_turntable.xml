    <!-- ===== 唱臂 ===== -->
    <!-- 底座投影 -->
    <path
        android:fillColor="#55000000"
        android:pathData="M92.6,18.2m-6.2,0a6.2,6.2 0 1,0 12.4,0a6.2,6.2 0 1,0 -12.4,0z" />
    <!-- 底座：黑盘 + 两道圈 + 金属轴 -->
    <path
        android:fillColor="#FF201A19"
        android:pathData="M92,17m-6.1,0a6.1,6.1 0 1,0 12.2,0a6.1,6.1 0 1,0 -12.2,0z" />
    <path
        android:pathData="M92,17m-6.0,0a6.0,6.0 0 1,0 12,0a6.0,6.0 0 1,0 -12,0z"
        android:strokeColor="#4DF0E4D4"
        android:strokeWidth="0.35" />
    <path
        android:pathData="M92,17m-4.4,0a4.4,4.4 0 1,0 8.8,0a4.4,4.4 0 1,0 -8.8,0z"
        android:strokeColor="#26F0E4D4"
        android:strokeWidth="0.4" />
    <path
        android:pathData="M87.6,14.2A5.4,5.4 0 0 1 90.6,11.9"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="0.5" />
    <path
