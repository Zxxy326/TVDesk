    <path
        android:pathData="M97.96,4.08L95.24,10.32"
        android:strokeColor="#55000000"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M97.56,4.28L94.84,10.52"
        android:strokeColor="#FFB0A698"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M94.57,5.38L98.79,7.22"
