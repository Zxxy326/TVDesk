    android:width="460dp"
    android:height="460dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- ===== 固定在盘面上的两处反光（光源不动，盘在下面转） ===== -->
    <path
        android:pathData="M15.6,33.9A38,38 0 0 1 33.9,15.6"
        android:strokeColor="#0EFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M69,82.9A38,38 0 0 1 50,88"
        android:strokeColor="#08FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- ===== 主轴：盖在标签/封面正中，真机上这里就是一根轴 ===== -->
    <path
        android:pathData="M50,50m-2.4,0a2.4,2.4 0 1,0 4.8,0a2.4,2.4 0 1,0 -4.8,0z"
        android:strokeColor="#4DFFE9DA"
        android:strokeWidth="0.45" />
    <path
        android:fillColor="#FFB4ABA0"
        android:pathData="M50,50m-1.6,0a1.6,1.6 0 1,0 3.2,0a1.6,1.6 0 1,0 -3.2,0z" />
    <path
