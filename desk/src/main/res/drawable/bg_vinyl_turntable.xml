        android:strokeWidth="0.45" />
    <path
        android:pathData="M96.46,3.8L93.74,10.04"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="0.5"
        android:strokeLineCap="round" />

    <!-- 臂管：贯穿支点，落到盘面右下 -->
