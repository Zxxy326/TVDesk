    <path
        android:fillColor="#40000000"
        android:pathData="M72.2,62.6L77.0,64.6L72.4,76.0L67.6,74.0z" />
    <path
        android:fillColor="#FFCFC6BA"
        android:pathData="M71.6,61.8L76.4,63.8L71.9,74.6L67.1,72.6z" />
    <path
        android:pathData="M71.6,61.8L76.4,63.8L71.9,74.6L67.1,72.6z"
        android:strokeColor="#99FFF6E9"
        android:strokeWidth="0.25" />
    <path
        android:pathData="M72.3,62.5L68.4,73.0"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="0.4" />
    <path
        android:fillColor="#FF211C1A"
        android:pathData="M69.2,68.1L73.6,69.9L71.7,75.5L67.3,73.7z" />
    <path
        android:pathData="M69.6,68.8L72.9,70.2"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="0.35" />
    <path
        android:fillColor="#FFFF8A3C"
        android:pathData="M68.4,76.2m-1.15,0a1.15,1.15 0 1,0 2.3,0a1.15,1.15 0 1,0 -2.3,0z" />

