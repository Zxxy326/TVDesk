<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮播放条的底。和顶栏那两颗胶囊同一套语言（radius_control 全胶囊 + 半透明深底），
  但它比 bg_pill 多两件事：
  - 描边：浮在卡片墙上面，没有一圈亮边就看不出「这是独立的一层」；
  - 上浅下深的渐变：底部压深一点，白色封面上滚过去时不至于和条子糊成一片。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#F00A0910"
        android:startColor="#F21A1822"
        android:type="linear" />
    <corners android:radius="@dimen/radius_control" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
