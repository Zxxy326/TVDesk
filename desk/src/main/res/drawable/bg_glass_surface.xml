<?xml version="1.0" encoding="utf-8"?>
<!--
  模块页顶栏 / 侧栏 / 开关条的统一玻璃底。

  参数全部来自 Aerial 的 LiquidGlass（用户点名要「和主页一样」）：
  底色 #E6202022、上沿白 0.10 到 50% 淡完、描边 1.2dp 四段 0.55/0.10/0.06/0.30。
  以前这里是手写的 layer-list：描边 1dp、单色、高光到 55%，和桌面的 GlassDrawable
  差一点点，九块面板摆在一起就能看出不是一套。现在两边共用一个 Drawable 实现。
-->
<com.tvdesk.desk.widget.GlassSurface
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:glassRadius="@dimen/radius_control" />
