<?xml version="1.0" encoding="utf-8"?>
<!--
  沉浸播放页压在封面之上的那层蒙版。
  上面已经有一层酒红房间底（bg_stage_room），这层只负责把歌词那半边压暗，
  顺便给底部曲名留对比；再像以前那样铺满黑，酒红就全被吃掉了。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#26000000"
        android:endColor="#B3000000"
        android:startColor="#4D000000"
        android:type="linear" />
</shape>
